{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/visual-review\" hook",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/visual-review\" hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/visual-review\" hook",
            "timeout": 30
          }
        ],
        "matcher": "Bash|exec_command|functions.exec_command|.*__exec_command|apply_patch|functions.apply_patch|Write|Edit|MultiEdit|.*__write_file|.*__edit_file|.*[Gg]ithub.*[Cc]reate.*[Pp]ull.*[Rr]equest|.*__create_pr"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/visual-review\" hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
